@{
    ViewData["Title"] = "Time Slots";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Booking.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />
}

<div class="booking-page">
    <div class="info-box">
        <h2>Information</h2>
        <p>Her kan du senere vise detaljer om bookinger, tider, osv.</p>
    </div>

    <div id="calendar" style="height:700px;"></div>
</div>

<!-- Optional debug output -->
<pre id="debug">@Html.Raw(ViewBag.BookingJson)</pre>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Deserialize events from ViewBag
            var events = @Html.Raw(ViewBag.BookingJson);

            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                timeZone: 'Europe/Copenhagen',
                locale: 'da',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                slotMinTime: "06:00:00",
                slotMaxTime: "23:59:59",
                slotLabelFormat: [{
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                }],
                events: events,
                eventClick: function(info) {
                    var ext = info.event.extendedProps;
                    alert(
                        'Tid: ' + info.event.title + '\n' +
                        'Dato: ' + new Date(ext.date).toLocaleDateString('da-DK') + '\n' +
                        'Kapacitet: ' + ext.capacity + '\n' +
                        'Ledig: ' + (ext.isAvailable ? 'Ja' : 'Nej')
                    );
                },
                dateClick: function(info) {
                    calendar.changeView('timeGridWeek', info.date);
                }
            });

            calendar.render();
        });
    </script>
}
