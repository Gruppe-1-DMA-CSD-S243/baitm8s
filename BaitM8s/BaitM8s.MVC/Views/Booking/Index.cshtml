<pre>@Html.Raw(ViewBag.BookingJson)</pre>

<div class="booking-page">
    <div class="info-box">
        <h2>information</h2>
        <p>her kan du senere vise detaljer om bookinger, tider, osv.</p>
    </div>

    <!--<div class="calendar-container">
        <div class="top-box">
            <h3>top boks</h3>
            <p>her kan du vise fx filter, opsummering eller andet indhold.</p>
    </div>-->

    <div id="calendar"></div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var events = @Html.Raw(ViewBag.BookingJson);

            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                timeZone: 'Europe/Copenhagen',
                locale: 'da',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                slotMinTime: "06:00:00",
                slotMaxTime: "23:59:59",
                slotLabelFormat: [{
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                }],
                events: events,
                eventClick: function(info) {
                    alert('Du klikkede på: ' + info.event.title);
                },
                dateClick: function(info) {
                    calendar.changeView('timeGridWeek', info.date);
                }
            });

            calendar.render();
        });
    </script>
}