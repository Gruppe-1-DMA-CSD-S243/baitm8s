@model IEnumerable<BaitM8s.DAL.DTO.BookingDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumberOfPeople)
            </th>
            <th>
                Date
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FK_AnglerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FK_FishingSpotId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumberOfPeople)
            </td>
            <td>
                 @($"{new DateTime(item.Year, item.Month, item.Day).ToString("dd-MM-yyyy")}")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FK_AnglerId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FK_FishingSpotId)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>
