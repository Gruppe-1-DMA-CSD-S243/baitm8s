@using System.Globalization
@model FishingSpotAvailabilityViewModel

@{
    var days = Model.WeekDates;
    int weekNumber = ISOWeek.GetWeekOfYear(DateTime.Now);
    var weeks = Enumerable.Range(1, 52).Reverse();
    int yearNumber = DateTime.Now.Year;
    var years = Enumerable.Range(yearNumber, 2100).Reverse();
    TimeSpan startTime = new TimeSpan(Model.FishingSpot.StartAvailableHours, 0, 0);
    TimeSpan endTime = new TimeSpan(Model.FishingSpot.EndAvailableHours, 0, 0);
    TimeSpan slotDuration = new TimeSpan(1, 0, 0);
}
<form method="get" asp-action="AvailableTimes" asp-controller="Booking">
    <input type="hidden" name="id" value="@Model.FishingSpot.Id" />
    <label for="weekNumber" style="display:inline-block; margin-right: 10px;">
        Week Number:
    </label>
    <select name="weekNumber" id="weekNumber" style="width: 100px; height: 40px; display:inline-block;" onchange="this.form.submit()">
        
        @for (int week = 52; week >= 1; week--)
        {
            if (week == Model.SelectedWeek)
            {
                <option value="@week" selected>@week</option>
            }
            else
            {
                <option value="@week">@week</option>
            }
        }
    </select>

    <label for="weekNumber" style="display:inline-block; margin-right: 10px;">
        Year:
    </label>
    <select class="form-select" id="year" name="year" style="width: 100px; height: 40px; display:inline-block;" onchange="this.form.submit()">
        @for (int y = yearNumber; y <= 2100; y++)
        {
            if (y == Model.SelectedYear)
            {
                <option value="@y" selected>@y</option>
            }
            else
            {
                <option value="@y">@y</option>
            }
        }
    </select>
    <label style="display:inline-block; margin-right: 10px;">
        Number of people:
    </label>
    <select class="form-select" id="numberOfPeople" name="numberOfPeople" style="width: 100px; height: 40px; display:inline-block;" onchange="this.form.submit()"> 
        @for (int i = 1; i < Model.FishingSpot.Capacity + 1; i++) 
        {
            if (i == Model.NumberOfPeople)
            {
                <option value="@i" selected>@i</option>
            }
            else
            {
                <option value="@i">@i</option>
            }
        }
    </select>
</form>

<table class="table table-bordered text-center">
    <thead>
        <tr>
            @foreach (var date in days)
            {
                <th>
                    @date.ToString("dddd")<br />
                    @date.ToString("dd/MM/yyyy")
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @for (var time = startTime; time < endTime; time = time.Add(slotDuration))
        {
            var timeSlot = $"{time:hh\\:mm} - {time.Add(slotDuration):hh\\:mm}";

            <tr>
                @foreach (var date in days)
                {
                    string testStr = $"{date.Day}-{time.Hours}";

                    @if (Model.BookedPeople.ContainsKey(testStr))
                    {
                        @if (Model.FishingSpot.Capacity < Model.BookedPeople[testStr] + Model.NumberOfPeople) 
                        {
                        <td>
                        <a asp-controller="Booking"
                           asp-action="BookAvailableTime"
                           asp-route-id="@Model.FishingSpot.Id"
                           asp-route-day="@date.Day"
                           asp-route-year="@date.Year"
                           asp-route-month="@date.Month"
                           asp-route-startTime="@time.Hours"
                           asp-route-endTime="@time.Add(slotDuration).Hours"
                           class="btn btn-outline-primary btn-sm" style="background-color: red; pointer-events: none">
                            @timeSlot
                        </a>
                        </td>
                        }
                    }
                    else
                    {
                        <td>
                        <a asp-controller="Booking"
                           asp-action="BookAvailableTime"
                           asp-route-id="@Model.FishingSpot.Id"
                           asp-route-day="@date.Day"
                           asp-route-year="@date.Year"
                           asp-route-month="@date.Month"
                           asp-route-startTime="@time.Hours"
                           asp-route-endTime="@time.Add(slotDuration).Hours"
                           class="btn btn-outline-primary btn-sm">
                            @timeSlot
                        </a>
                        </td>
                    }
                    
                }
            </tr>
        }
    </tbody>
</table>
