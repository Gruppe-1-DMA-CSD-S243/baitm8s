@model BaitM8s.DAL.DTO.FishingSpotDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-6">

        <h1 class="text-center mb-4">Fishing Spot Details</h1>

        <div>
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Name)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Name)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Address)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Address)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ZipCode)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.ZipCode)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Capacity)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Capacity)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.HandicapFriendly)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.HandicapFriendly)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.StartAvailableHours)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.StartAvailableHours)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.EndAvailableHours)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.EndAvailableHours)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FK_PondOwnerId)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.FK_PondOwnerId)</dd>
            </dl>
        </div>

        <div class="mt-3 text-center">
            <a class="btn btn-primary me-2"
               asp-controller="Booking"
               asp-action="AvailableTimes"
               asp-route-id="@Model.Id">
                Book a spot
            </a>

            <a class="btn btn-secondary"
               asp-action="Map">
                Back to Map
            </a>
        </div>

    </div>
</div>