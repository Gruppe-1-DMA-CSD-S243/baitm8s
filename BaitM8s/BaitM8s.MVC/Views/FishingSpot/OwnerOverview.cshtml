@model IEnumerable<BaitM8s.DAL.DTO.FishingSpotDTO>

@{
    ViewData["Title"] = "OwnerOverview";
}

<h1>OwnerOverview</h1>

<p>
    <a asp-action="RegisterOwnership">Register a fishing spot</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.ActionLink("Manage", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "OwnerDetails", new { id = item.Id }) |
                    @Html.ActionLink("Remove Ownership", "RemoveOwnership", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>
