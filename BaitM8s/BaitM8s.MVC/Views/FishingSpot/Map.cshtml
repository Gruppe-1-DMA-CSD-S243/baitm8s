@using BaitM8s.DAL.DTO
@using System.Globalization
@model IEnumerable<FishingSpotDTO>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<!--Leaflet div-->
<div id="map" style="height: 70vh"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="">
</script>

<script>
	var userLat = 57.03;
	var userLon = 9.92;

    var map = L.map('map').setView([userLat, userLon], 13);

	L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
	}).addTo(map);

 //    L.tileLayer('https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.{ext}', {
	// minZoom: 0,
	// maxZoom: 20,
	// attribution: '&copy; <a href="https://www.stadiamaps.com/" target="_blank">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
	// ext: 'png'
	// }).addTo(map);

	@foreach(var spot in Model)
	{
		<text> <!--CultureInfo er nødvendigt! Det sørger for at float værdierne skrives med punktum!-->
			var marker = L.marker([@spot.Latitude.ToString(CultureInfo.InvariantCulture), @spot.Longitude.ToString(CultureInfo.InvariantCulture)]).addTo(map);
			marker.bindPopup("@spot.Name", { closeButton: false });
			marker.on('mouseover', function() {
				this.openPopup();
			});
			marker.on('mouseout', function () {
				this.closePopup();
			});
			marker.on('click', function() {
				window.location.href = "@Url.Action("Details", "FishingSpot", new { id = spot.Id })";
			});
		</text>
	}
</script>